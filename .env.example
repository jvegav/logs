# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logs_db
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================================
# Supabase Storage Configuration
# ==========================================
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API Key (service_role or anon key with storage permissions)
SUPABASE_KEY=your-supabase-api-key-here

# Supabase Storage Bucket name (create this bucket in Supabase Storage with public read access)
SUPABASE_BUCKET=journal-images

# ==========================================
# Application Configuration
# ==========================================
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
